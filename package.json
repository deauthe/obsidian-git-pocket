{
  "name": "obsidian-git-pocket",
  "version": "0.3.0",
  "description": "Git for Obsidian that is actually usable on a phone.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "esbuild src/git.ts src/ui/squash-modal.ts --bundle --outdir=build-test --format=esm --platform=node --external:isomorphic-git --alias:obsidian=./test/obsidian-stub.mjs --inject:src/shims.ts --log-level=error && node test/run.mjs",
    "install-local": "node scripts/install-local.mjs"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.27.1"
  }
}
